# ─────────────────────────────────────────────────────────
# Riman HR — Environment Variables
# Copy this file to .env and fill in the values below.
# ─────────────────────────────────────────────────────────

# Database (PostgreSQL 14+)
# Example for local: postgresql://riman:riman_dev@localhost:5432/riman_hr
# Production: use a managed PostgreSQL connection string
DATABASE_URL=

# NextAuth secret — must be ≥16 random characters
# Generate one with: npx auth secret
AUTH_SECRET=

# Public base URL of the deployed app (required for cookies in production)
# Local: http://localhost:3000
# Production: https://your-domain.com
AUTH_URL=

# ─────────────────────────────────────────────────────────
# Optional: Email notifications via Resend
# Remove these or leave blank to suppress email (logs only)
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@your-domain.com
