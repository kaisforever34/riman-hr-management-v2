{
  "appId": "com.riman.hr",
  "productName": "Riman HR Management",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/main.js",
    "electron/preload.js"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone"
    },
    {
      "from": ".next/static",
      "to": "standalone/.next/static"
    },
    {
      "from": "public",
      "to": "standalone/public"
    },
    {
      "from": "prisma",
      "to": "standalone/prisma"
    },
    {
      "from": "electron/node",
      "to": "node"
    }
  ],
  "asar": false,
  "win": {
    "target": "portable",
    "icon": "public/favicon.ico"
  }
}
